# --- Database ---
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://nexus:change-me@db:5432/nexus

# --- Auth ---
JWT_SECRET=change-me-use-32-plus-random-characters

# --- LLM (Groq, OpenAI-compatible) ---
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
MODEL_LLM=openai/gpt-oss-120b
MODEL_JUDGE_EVAL=openai/gpt-oss-120b
LLM_MAX_ATTEMPTS=3
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TIMEOUT_SECONDS=60

# --- Budget (enforced by the backend) ---
LLM_MAX_TOKENS_PER_JOB=12000
LLM_DAILY_BUDGET_USD=5
# Take the real prices from the provider's pricing page, e.g.
# LLM_PRICING_JSON='{"openai/gpt-oss-120b":{"input_per_1m":0.0,"output_per_1m":0.0}}'
# While empty, cost is recorded as 0 and flagged "pricing not configured".
LLM_PRICING_JSON={}
LLM_REQUIRE_PRICING=false

# --- Langfuse (Cloud free tier) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL="https://us.cloud.langfuse.com"
